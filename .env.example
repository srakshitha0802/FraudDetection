# Sentinel Environment Variables Configuration Template

# Database path (relative to process.cwd() or absolute path)
DATABASE_URL=sentinel.db

# API Port config
PORT=3000
NODE_ENV=production

# Model Service details
MODEL_PATH=models/sentinel_model.lgb
MODEL_VERSION=v3.0-lightgbm
CALIBRATION_PATH=models/calibration_metadata.json

# B2B Incident operating parameters
MONITOR_THRESHOLD=0.02
REVIEW_THRESHOLD=0.03
PROTECT_THRESHOLD=0.20

# Gemini AI Credentials (Required)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Orchestrator Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/fraud-alert
